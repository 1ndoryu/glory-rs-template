{
  "schemaVersion": 1,
  "installRoot": ".quality-tools",
  "tools": {
    "sentinel": {
      "repository": "https://github.com/1ndoryu/glory-sentinel.git",
      "sourcePathEnv": "GLORY_SENTINEL_SOURCE_PATH",
      "commit": "9f4ed4d4d866a016022f2458e69c0226eeee345a",
      "version": "0.4.0",
      "outputSchemaVersion": "1",
      "buildScript": "compile",
      "cli": "out/cli/index.js"
    },
    "varsense": {
      "repository": "https://github.com/1ndoryu/varsense.git",
      "sourcePathEnv": "GLORY_VARSENSE_SOURCE_PATH",
      "commit": "11f0932de5e66d88a79fdaa960ca77e5774d0a33",
      "version": "2.2.0",
      "outputSchemaVersion": "1",
      "buildScript": "compile",
      "cli": "dist/cli/index.js",
      "testScript": "test",
      "capabilities": {
        "filesFrom": true,
        "persistentIndex": true
      }
    }
  }
}
