# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/glory_db

# Secret para firmar tokens JWT — cambiar en producción
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars

# Servidor
HOST=127.0.0.1
PORT=3000

# Volumen local de fotos subidas (servido en /uploads, gitignored)
UPLOAD_DIR=./uploads

# Base pública para `media_url` de fotos que la IA envía por WhatsApp [299A-1 E13]:
# en producción lleva el dominio público (los servidores de WhatsApp la descargan).
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Centro de IA de texto [199A-1]: las claves viven solo aqui, nunca en Configuracion.
# GLORY_API_URL por defecto http://127.0.0.1:3101 si se deja vacio.
GLORY_API_URL=
GLORY_API_KEY=
OPENCODE_GO_API_KEY=

# Logging (trace, debug, info, warn, error)
RUST_LOG=glory_backend=debug,tower_http=debug

# Gateway Baileys (289A-1): worker -> http://127.0.0.1:3102/send
GLORY_ALERT_GATEWAY_URL=http://127.0.0.1:3102/send
# Secreto compartido worker->gateway (cabecera X-Gateway-Secret); vacio = sin exigir
GATEWAY_SEND_SECRET=
# Secreto gateway->backend (cabecera X-Gateway-Secret en /agent/whatsapp/webhook)
WA_WEBHOOK_SECRETO=
# Sesiones del gateway (dentro de gateway/): numero propio de cada sesion
SESSION_A_NUMBER=584120825234
SESSION_B_NUMBER=18149575416
GATEWAY_PORT=3102
BACKEND_WEBHOOK_URL=http://127.0.0.1:3000/api/agent/whatsapp/webhook
