{
  "schemaVersion": 1,
  "maxFindings": 3,
  "maxReminders": 4,
  "maxTerminalLines": 20,
  "lockWaitMs": 0,
  "maxConcurrentStages": 1,
  "timeoutsMs": {
    "sentinel": 120000,
    "varsense": 120000,
    "rust": 300000,
    "frontend": 120000,
    "frontendTest": 300000
  },
  "performanceBudgets": {
    "entryJsGzipBytes": 65000,
    "entryCssGzipBytes": 16000,
    "largestChunkGzipBytes": 120000
  },
  "heavyRun": {
    "cooldownMinutes": 180,
    "maxTargetGb": 15,
    "maxTargetAgeDays": 7,
    "maxConcurrent": 1
  },
  "fullPatterns": [
    "Cargo.toml",
    "Cargo.lock",
    "frontend/vite.config.ts",
    "frontend/vitest.config.ts",
    "sentinel.config.json",
    "varsense.config.json",
    "quality.config.json",
    "quality-tools.json",
    ".github/",
    "scripts/quality/",
    "migrations/"
  ],
  "profiles": {
    "rust": [".rs", "Cargo.toml", "Cargo.lock", "migrations/"],
    "frontend": ["frontend/"],
    "css": [".css", ".scss", ".less"],
    "docs": [".md", "AGENTS.md", "roadmap.md", "Agente/"],
    "auth": ["auth", "session", "login", "middleware"],
    "commerce": ["product", "order", "stripe", "checkout", "upload"],
    "desktop": ["frontend/src/features/desktop/"],
    "mobile": ["mobile", "responsive"],
    "workspace": ["workspace", "overlay", "layout"]
  }
}
