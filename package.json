{
  "name": "glory-rs",
  "private": true,
  "description": "Comandos unificados para el monorepo Rust + React",
  "scripts": {
    "dev": "node glory-rs/scripts/dev.mjs",
    "check": "cargo check && cargo clippy && npm --prefix frontend run type-check",
    "self-check": "powershell -ExecutionPolicy Bypass -File scripts/self-check.ps1",
    "check:back": "cargo check && cargo clippy",
    "check:front": "npm --prefix frontend run type-check",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "clean:cargo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-cargo-target.ps1",
    "setup:cargo-cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-cargo-cleanup.ps1",
    "dev:back": "cargo run --bin glory-backend",
    "dev:front": "npm --prefix frontend run dev",
    "codegen": "npm --prefix frontend run codegen",
    "test": "cargo test",
    "roadmap": "node scripts/check-roadmap.mjs",
    "roadmap:watch": "node scripts/check-roadmap.mjs --watch",
    "prerender": "node scripts/prerender.mjs",
    "quality:setup": "node scripts/quality/quality-setup.mjs",
    "quality:doctor": "node scripts/quality/quality-doctor.mjs",
    "quality:analyze": "node scripts/quality/sentinel-analyze.mjs",
    "quality:check": "node scripts/quality/task-check.mjs",
    "quality:check:local": "node scripts/quality/task-check-local.mjs",
    "quality:lock": "node scripts/quality/lock-generator.mjs"
  },
  "devDependencies": {
    "puppeteer": "^25.0.3",
    "typescript": "^6.0.3"
  }
}
