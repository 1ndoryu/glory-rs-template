{
  "variableFiles": [
    "frontend/src/styles/variables.css",
    "frontend/src/App.css"
  ],
  "includePatterns": [
    "frontend/src/**/*.css",
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx"
  ],
  "excludePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.quality-tools/**",
    "**/.quality-reports/**",
    "**/.sentinel/**",
    "frontend/src/api/generated/**"
  ],
  "scanAllFiles": false,
  "hardcodedDetection": {
    "enabled": true,
    "severity": "warning"
  },
  "inlineDetection": {
    "enabled": true,
    "severity": "information"
  },
  "tokenDetection": {
    "duplicate": {
      "enabled": false,
      "severity": "warning"
    },
    "unused": {
      "enabled": true,
      "severity": "hint"
    }
  },
  "bannedProperties": {
    "enabled": true,
    "severity": "warning",
    "properties": [
      "box-shadow"
    ]
  },
  "orphanClassDetection": {
    "minClassLength": 3,
    "excludeClassPatterns": ["uplot", "u-legend", "tiptap", "is-editor-empty"]
  }
}
