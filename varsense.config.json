{
  "variableFiles": [
    "frontend/src/styles/variables.css"
  ],
  "includePatterns": [
    "frontend/src/**/*.css",
    "frontend/src/**/*.ts"
  ],
  "excludePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "frontend/src/api/generated/**"
  ],
  "scanAllFiles": false,
  "hardcodedDetection": {
    "enabled": true,
    "severity": "warning",
    "properties": {
      "color": true,
      "background": true,
      "background-color": true,
      "border-color": true,
      "border-radius": true,
      "font-size": true,
      "font-family": true,
      "box-shadow": true
    },
    "allowedValues": [
      "0",
      "0px",
      "auto",
      "inherit",
      "initial",
      "unset",
      "none",
      "100%",
      "50%",
      "transparent",
      "currentColor"
    ]
  },
  "inlineDetection": {
    "enabled": true,
    "severity": "warning"
  },
  "bannedProperties": {
    "enabled": true,
    "severity": "warning",
    "properties": [
      "box-shadow"
    ]
  },
  "orphanClassDetection": {
    "minClassLength": 3,
    "excludeClassPatterns": [
      "^lucide($|-)",
      "^is-",
      "^js-"
    ]
  }
}
